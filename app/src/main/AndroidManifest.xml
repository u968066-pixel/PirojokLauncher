<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Вот эта строчка дает нам право видеть другие приложения -->
    <queries>
        <package android:name="git.artdeell.mjlaunch" />
        <package android:name="git.artdeell.mojo" />
        <package android:name="net.kdt.pojavlaunch" />
    </queries>
    
    <application
        android:allowBackup="true"
        android:label="PirozhokLauncher"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
